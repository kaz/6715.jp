{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["void/env", "node"],
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "pages",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db",
    "build",
    "vite.config.ts",
    "void.config.ts",
    "playwright.config.ts",
    "tests",
    ".void/**/*.d.ts",
    "scripts"
  ]
}
